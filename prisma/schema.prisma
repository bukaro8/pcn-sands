generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IssuerType {
  COUNCIL
  PRIVATE
}

enum NoticeType {
  ORIGINAL_PCN
  NOTICE_TO_OWNER
  PRIVATE_PARKING_NOTICE
  OTHER
}

enum ChallengeStatus {
  AWAITING_CHALLENGE
  AWAITING_DECISION
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  NOT_REQUIRED
  PAYMENT_REQUIRED
  PAYMENT_UNCONFIRMED
  PAID
}

enum ChallengeStage {
  INITIAL
  FORMAL
  INDEPENDENT
}

enum ChallengeOutcome {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportType {
  WEEKLY
  MONTHLY
}

enum EmailDeliveryStatus {
  NOT_SENT
  SENT
  FAILED
}

enum ReminderType {
  CHALLENGE_STATUS_CHECK
  PAYMENT_DEADLINE
}

enum ReminderStatus {
  PENDING
  NOTIFIED
  COMPLETED
}

enum JobType {
  WEEKLY_REPORT
  REMINDER_DELIVERY
}

enum JobStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model Vehicle {
  id                     String   @id @default(cuid())
  registrationNormalized String   @unique
  registrationDisplay    String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  pcns                   Pcn[]
}

model Issuer {
  id             String     @id @default(cuid())
  name           String
  normalizedName String     @unique
  type           IssuerType
  challengeUrl   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  pcns           Pcn[]
}

model Pcn {
  id                    String          @id @default(cuid())
  reference             String          @unique
  vehicleId             String
  issuerId              String
  contraventionCode     String?
  contraventionLocation String
  contraventionDate     DateTime        @db.Date
  issueDate             DateTime        @db.Date
  noticeType            NoticeType
  challengeStatus       ChallengeStatus @default(AWAITING_CHALLENGE)
  paymentStatus         PaymentStatus   @default(NOT_REQUIRED)
  paymentDeadline       DateTime?       @db.Date
  paymentReference      String?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  vehicle               Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  issuer                Issuer          @relation(fields: [issuerId], references: [id], onDelete: Restrict)
  challenges            Challenge[]
  reportEntries         ReportEntry[]
  reminders             Reminder[]

  @@index([vehicleId])
  @@index([issuerId])
  @@index([challengeStatus])
  @@index([paymentStatus, paymentDeadline])
}

model Challenge {
  id                   String           @id @default(cuid())
  pcnId                String
  stage                ChallengeStage
  submissionDate       DateTime?        @db.Date
  outcome              ChallengeOutcome @default(PENDING)
  decisionDate         DateTime?        @db.Date
  expectedResponseDate DateTime?        @db.Date
  nextStatusCheckDate  DateTime?        @db.Date
  challengeText        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  pcn                  Pcn              @relation(fields: [pcnId], references: [id], onDelete: Cascade)
  reminders            Reminder[]

  @@index([pcnId, stage])
  @@index([outcome, nextStatusCheckDate])
  @@unique([pcnId, stage, submissionDate])
}

model ReportHistory {
  id                  String              @id @default(cuid())
  type                ReportType
  periodStart         DateTime            @db.Date
  periodEnd           DateTime            @db.Date
  generatedAt         DateTime            @default(now())
  emailDeliveryStatus EmailDeliveryStatus @default(NOT_SENT)
  emailSentAt         DateTime?
  emailAttemptedAt    DateTime?
  emailProviderId     String?
  emailError          String?
  entries             ReportEntry[]

  @@index([type, periodStart, periodEnd])
  @@unique([type, periodStart, periodEnd])
}

model ReportEntry {
  id                  String          @id @default(cuid())
  reportId            String
  pcnId               String
  challengeStatus     ChallengeStatus
  paymentStatus       PaymentStatus
  paymentDeadline     DateTime?       @db.Date
  paymentNoticeNumber Int?
  report              ReportHistory   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  pcn                 Pcn             @relation(fields: [pcnId], references: [id], onDelete: Restrict)

  @@unique([reportId, pcnId])
  @@index([pcnId, paymentNoticeNumber])
}

model Reminder {
  id          String         @id @default(cuid())
  pcnId       String
  challengeId String?
  type        ReminderType
  eventKey    String         @unique
  dueAt       DateTime
  status      ReminderStatus @default(PENDING)
  notifiedAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  pcn         Pcn            @relation(fields: [pcnId], references: [id], onDelete: Cascade)
  challenge   Challenge?     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  delivery    ReminderDelivery?

  @@index([status, dueAt])
  @@index([pcnId, type])
  @@index([challengeId])
}

model ReminderDelivery {
  id          String              @id @default(cuid())
  reminderId  String              @unique
  recipient   String
  status      EmailDeliveryStatus @default(NOT_SENT)
  providerId  String?
  error       String?
  attemptedAt DateTime?
  sentAt      DateTime?
  attempts    Int                 @default(0)
  reminder    Reminder            @relation(fields: [reminderId], references: [id], onDelete: Cascade)
}

model JobExecution {
  id           String    @id @default(cuid())
  jobKey       String    @unique
  type         JobType
  status       JobStatus
  attempts     Int       @default(1)
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type, status])
}

model LoginAttempt {
  id            String   @id @default(cuid())
  key           String   @unique
  failureCount  Int      @default(0)
  windowStarted DateTime @default(now())
  lockedUntil   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([lockedUntil])
}
