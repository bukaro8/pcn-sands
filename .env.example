# PostgreSQL connection string supplied by the local database or Coolify secret.
DATABASE_URL="postgresql://pcn_user:local_dev_password@127.0.0.1:55432/pcn_management?schema=public"

# Next.js listens on all interfaces inside the container.
HOSTNAME="0.0.0.0"
PORT="3000"

# Optional AI-assisted PCN extraction. Leave unset to use manual entry only.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Email delivery and protected scheduled jobs.
RESEND_API_KEY=""
EMAIL_FROM="Sands PCN Management <sands-pnc-management@vicstack.uk>"
ADMIN_EMAIL=""
CRON_SECRET=""

# Single-administrator authentication. Generate AUTH_SECRET and ADMIN_PASSWORD_HASH
# using the documented commands; never set a plaintext password here.
AUTH_SECRET=""
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
